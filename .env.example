# Copy to .env.local and fill in real values. Never commit .env.local.

# Database (Docker container flouri-mysql)
LFMIS_DB_HOST=127.0.0.1
LFMIS_DB_PORT=4321
LFMIS_DB_NAME=lfmis
LFMIS_DB_USER=flouri_admin
LFMIS_DB_PASSWORD=

# Services
LFMIS_ML_URL=http://127.0.0.1:5000
LFMIS_APP_URL=http://127.0.0.1:5173
LFMIS_MAIL_FROM=
LFMIS_DEV_LOG_PASSWORD_RESET_LINK=0

# Assistant (optional model mode; any OpenAI-compatible endpoint)
LFMIS_AI_API_URL=
LFMIS_AI_API_KEY=
LFMIS_AI_MODEL=

# M-Pesa Daraja
LFMIS_MPESA_ENV=sandbox
LFMIS_MPESA_CONSUMER_KEY=
LFMIS_MPESA_CONSUMER_SECRET=
LFMIS_MPESA_SHORTCODE=
LFMIS_MPESA_PASSKEY=
LFMIS_MPESA_CALLBACK_BASE=
LFMIS_MPESA_CALLBACK_SECRET=
LFMIS_MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
LFMIS_MPESA_PARTY_B=

# Weather (farm coordinates)
LFMIS_FARM_LAT=
LFMIS_FARM_LON=
