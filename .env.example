# Copy to .env.local and fill in real values. Never commit .env.local.

# Database (Docker container flouri-mysql)
LFMIS_DB_HOST=127.0.0.1
LFMIS_DB_PORT=4321
LFMIS_DB_NAME=lfmis
LFMIS_DB_USER=flouri_admin
LFMIS_DB_PASSWORD=

# Services
LFMIS_ML_URL=http://127.0.0.1:5000
LFMIS_APP_URL=http://127.0.0.1:5173
LFMIS_MAIL_FROM=
LFMIS_MAIL_FROM_NAME=Flouri Farm LFMIS
LFMIS_SMTP_HOST=smtp.gmail.com
LFMIS_SMTP_PORT=587
LFMIS_SMTP_SECURE=tls
LFMIS_SMTP_USER=
LFMIS_SMTP_PASSWORD=
LFMIS_DEV_LOG_EMAIL_VERIFICATION_LINK=0
LFMIS_DEV_LOG_PASSWORD_RESET_LINK=0
LFMIS_LOGIN_ALERTS_ENABLED=true
LFMIS_2FA_OTP_KEY=
LFMIS_2FA_KEY=
LFMIS_TRENDS_COUNTRY_CODE=KE
LFMIS_TRENDS_REGION=Kenya
LFMIS_TRENDS_ENABLED=true
LFMIS_GDELT_MAX_RECORDS=12
LFMIS_GDELT_TIMEOUT_SECONDS=10
LFMIS_SYNTHETIC_ENABLED=true
LFMIS_SYNTHETIC_SEED=
LFMIS_TRENDS_REPORTING_TIMEZONE=Africa/Nairobi
LFMIS_TRENDS_SCHEDULER_ENABLED=true

# Assistant (optional model mode; any OpenAI-compatible endpoint)
LFMIS_AI_API_URL=
LFMIS_AI_API_KEY=
LFMIS_AI_MODEL=gpt-4o-mini

# M-Pesa payments are simulated locally. No Daraja account or credentials are used.
LFMIS_MPESA_DEMO_MODE=1

# Weather (farm coordinates)
LFMIS_FARM_LAT=
LFMIS_FARM_LON=
