{
  "name": "flouri-farm/lfmis-backend",
  "description": "Flouri Farm Livestock Farm Management Information System API",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Lfmis\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lfmis\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testdox"
  }
}
